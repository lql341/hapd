def build_parser():
    p = argparse.ArgumentParser(
        prog="hapd",
        description="Sign, install and debug HarmonyOS HAP packages from Linux.")
    p.add_argument("--version", action="version", version=f"hapd {VERSION}")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--dry-run", action="store_true", help="print commands instead of running")
    sub = p.add_subparsers(dest="cmd", required=True)

    def sign_opts(sp):
        sp.add_argument("--p12")
        sp.add_argument("--cert", help="debug certificate (.cer from AGC)")
        sp.add_argument("--profile", help="debug profile (.p7b from AGC)")
        sp.add_argument("--alias")
        sp.add_argument("--password")
        sp.add_argument("--signing-dir", help="directory holding .p12/.cer/.p7b")
        sp.add_argument("--rename-bundle", metavar="NEW_NAME",
                        help="rewrite app.bundleName inside the HAP")
        sp.add_argument("--drop-permission", action="append", metavar="PERM")
        sp.add_argument("--strip-unsupported", action="store_true",
                        help="drop every permission the profile does not allow")
        sp.add_argument("--no-code-sign", action="store_true",
                        help="disable code signing (signCode 0)")

    sp = sub.add_parser("doctor", help="check toolchain, signing material and device")
    sign_opts(sp)
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("devices", help="list connected devices")
    sp.set_defaults(func=cmd_devices)

    sp = sub.add_parser("udid", help="print the device UDID (needed for AGC)")
    sp.add_argument("--target")
    sp.set_defaults(func=cmd_udid)

    sp = sub.add_parser("connect", help="connect over WLAN (hdc tconn ip:port)")
    sp.add_argument("addr")
    sp.set_defaults(func=cmd_connect)

    sp = sub.add_parser("info", help="inspect a HAP without touching a device")
    sp.add_argument("hap")
    sp.add_argument("--verify", action="store_true", help="also run verify-app")
    sp.set_defaults(func=cmd_info, needs_tools=False)

    sp = sub.add_parser("profiles", help="list local profiles with bundle/expiry")
    sp.add_argument("--signing-dir")
    sp.set_defaults(func=cmd_profiles)

    sp = sub.add_parser("sign", help="sign one or more HAP/HSP packages")
    sp.add_argument("hap", nargs="+")
    sp.add_argument("-o", "--output")
    sign_opts(sp)
    sp.set_defaults(func=cmd_sign)

    sp = sub.add_parser("install", help="install HAP/HSP packages (HSP first, with -s)")
    sp.add_argument("hap", nargs="+")
    sp.add_argument("--sign", action="store_true", help="sign before installing")
    sp.add_argument("--uninstall", action="store_true",
                    help="uninstall the same bundle name first")
    sp.add_argument("--replace", action="store_true",
                    help="on 9568332 (signature differs) uninstall and retry once")
    sp.add_argument("-o", "--output")
    sp.add_argument("--target")
    sign_opts(sp)
    sp.set_defaults(func=cmd_install)

    sp = sub.add_parser("uninstall", help="uninstall a bundle")
    sp.add_argument("bundle", nargs="?")
    sp.add_argument("--hap", help="read the bundle name from this HAP instead")
    sp.add_argument("--target")
    sp.set_defaults(func=cmd_uninstall)

    sp = sub.add_parser("screenshot", help="grab a device screenshot")
    sp.add_argument("-o", "--output", default="screenshot.jpeg")
    sp.add_argument("--target")
    sp.set_defaults(func=cmd_screenshot)

    sp = sub.add_parser("push", help="push a file to the device")
    sp.add_argument("local")
    sp.add_argument("remote")
    sp.add_argument("--target")
    sp.set_defaults(func=cmd_push)

    sp = sub.add_parser("pull", help="pull a file from the device")
    sp.add_argument("remote")
    sp.add_argument("local", nargs="?")
    sp.add_argument("--target")
    sp.set_defaults(func=cmd_pull)

    sp = sub.add_parser("renew", help="check replacement signing material before it expires")
    sp.add_argument("--cert", help="new debug certificate")
    sp.add_argument("--old-cert", help="certificate currently in use (default: HAPD_CERT)")
    sp.add_argument("--profile", help="new debug profile")
    sp.add_argument("--bundle", help="expected bundle name")
    sp.add_argument("--target")
    sp.set_defaults(func=cmd_renew)

    sp = sub.add_parser("keygen", help="create a keystore (.p12) and CSR for AGC")
    sp.add_argument("--name", default="hapd-key", help="file stem (default: hapd-key)")
    sp.add_argument("--alias", help="key alias (default: same as --name)")
    sp.add_argument("-o", "--out", default="signing", help="output directory")
    sp.add_argument("--password")
    sp.add_argument("--dname")
    sp.add_argument("--days", type=int, default=9125)
    sp.add_argument("--force", action="store_true")
    sp.set_defaults(func=cmd_keygen)

    sp = sub.add_parser("run", help="start an ability")
    sp.add_argument("bundle")
    sp.add_argument("--ability")
    sp.add_argument("--module", default="entry")
    sp.add_argument("--hap", help="read mainElement from this HAP")
    sp.add_argument("--target")
    sp.set_defaults(func=cmd_run)

    sp = sub.add_parser("log", help="stream hilog (ctrl-c to stop)")
    sp.add_argument("--filter")
    sp.add_argument("--target")
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("deploy", help="sign + install + run (accepts entry.hap lib.hsp ...)")
    sp.add_argument("hap", nargs="+")
    sp.add_argument("-o", "--output")
    sp.add_argument("--target")
    sp.add_argument("--no-install", action="store_true")
    sp.add_argument("--no-run", action="store_true")
    sp.add_argument("--replace", action="store_true",
                    help="on 9568332 uninstall the installed build and retry")
    sp.add_argument("--auto-fix", action="store_true",
                    help="retry automatically: 9568332 -> uninstall, 9568289 -> strip permissions")
    sp.add_argument("--max-fix", type=int, default=3)
    sign_opts(sp)
    sp.set_defaults(func=cmd_deploy)

    sp = sub.add_parser("update", help="download a build, then deploy it")
    sp.add_argument("source", help="URL or local path")
    sp.add_argument("--dir", default="dist")
    sp.add_argument("-o", "--output")
    sp.add_argument("--target")
    sp.add_argument("--no-install", action="store_true")
    sp.add_argument("--no-run", action="store_true")
    sp.add_argument("--replace", action="store_true")
    sp.add_argument("--auto-fix", action="store_true")
    sp.add_argument("--max-fix", type=int, default=3)
    sign_opts(sp)
    sp.set_defaults(func=cmd_update)

    sp = sub.add_parser("explain", help="decode a device error code")
    sp.add_argument("code")
    sp.set_defaults(func=cmd_explain, needs_tools=False)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if getattr(args, "needs_tools", True):
        hdc_path, jar = find_toolchain()
    else:
        hdc_path, jar = None, None
    try:
        return args.func(args, hdc_path, jar)
    except DryRun:
        return 0
    except HapdError as e:
        eprint(f"hapd: {e.msg}")
        return e.code
    except RuntimeError as e:
        eprint(f"hapd: {e}")
        return 4


if __name__ == "__main__":
    sys.exit(main())
