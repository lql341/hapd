def eprint(*a):
    print(*a, file=sys.stderr)


class HapdError(Exception):
    """Expected, user-facing failure. Carries the process exit code."""

    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.msg = msg
        self.code = code


def die(msg, code=1):
    raise HapdError(msg, code)


# --------------------------------------------------------------------------
# process helpers
# --------------------------------------------------------------------------
class DryRun(Exception):
    pass


def run(cmd, dry_run=False, capture=True, check=True, stdin=None):
    if dry_run:
        eprint("[dry-run] " + " ".join(cmd))
        return subprocess.CompletedProcess(cmd, 0, "", "")
    r = subprocess.run(cmd, capture_output=capture, text=True, stdin=stdin)
    if check and r.returncode != 0:
        out = (r.stdout or "") + (r.stderr or "")
        raise RuntimeError(f"command failed ({r.returncode}): {' '.join(cmd)}\n{out.strip()}")
    return r


# --------------------------------------------------------------------------
# toolchain discovery
# --------------------------------------------------------------------------
def find_toolchain():
    """Return (hdc_path, sign_tool_jar)."""
    cands = []
    if os.environ.get("HAPD_TOOLCHAIN"):
        cands.append(os.environ["HAPD_TOOLCHAIN"])
    if os.environ.get("COMMANDLINE_TOOL_DIR"):
        cands.append(os.environ["COMMANDLINE_TOOL_DIR"])
    cands.append(os.path.expanduser("~/opt/apps/harmonyos/command-line-tools"))
    cands += sorted(glob.glob(os.path.expanduser("~/opt/apps/harmonyos/*/command-line-tools")),
                    reverse=True)
    cands.append(os.path.expanduser("~/command-line-tools"))

    for clt in cands:
        tc = os.path.join(clt, "sdk", "default", "openharmony", "toolchains")
        hdc = os.path.join(tc, "hdc")
        jar = os.path.join(tc, "lib", "hap-sign-tool.jar")
        if os.path.isfile(hdc) and os.path.isfile(jar):
            return hdc, jar

    # last resort: PATH
    hdc = shutil.which("hdc")
    for clt in cands:
        jar = os.path.join(clt, "sdk", "default", "openharmony", "toolchains", "lib",
                           "hap-sign-tool.jar")
        if os.path.isfile(jar) and hdc:
            return hdc, jar
    die("HarmonyOS Command Line Tools not found.\n"
        "  Set HAPD_TOOLCHAIN=/path/to/command-line-tools or install them to\n"
        "  ~/opt/apps/harmonyos/<version>/command-line-tools/", code=3)


def java_cmd():
    java = shutil.which("java")
    if not java:
        die("java not found (JDK 17 or 21 required to run hap-sign-tool)", code=3)
    return java


# --------------------------------------------------------------------------
# HAP inspection
# --------------------------------------------------------------------------
def read_module_json(path):
    try:
        with zipfile.ZipFile(path) as z:
            try:
                raw = z.read("module.json")
            except KeyError:
                die(f"{os.path.basename(path)}: no module.json inside - "
                    f"is this a HAP/HSP? (.app archives must be unpacked first, "
                    f"e.g. with app_unpacking_tool.jar)", code=2)
    except zipfile.BadZipFile:
        die(f"{os.path.basename(path)}: not a zip archive (corrupt or unfinished download)",
            code=2)
    return json.loads(raw)


def detect_signature(path):
    """A signed HAP carries a signing block at the end of the file: a base64
    certificate chain plus the profile. `META-INF` is an APK-ism and never
    appears in HAPs, so look for the PEM trailer instead."""
    size = os.path.getsize(path)
    with open(path, "rb") as f:
        f.seek(max(0, size - 262144))
        tail = f.read()
    return b"BEGIN CERTIFICATE" in tail


def hap_info(path):
    if not os.path.isfile(path):
        die(f"no such file: {path}", code=2)
    app = read_module_json(path)["app"]
    m = read_module_json(path)["module"]
    return {
        "path": os.path.abspath(path),
        "size": os.path.getsize(path),
        "bundle_name": app.get("bundleName"),
        "version_name": app.get("versionName"),
        "version_code": app.get("versionCode"),
        "min_api": app.get("minAPIVersion"),
        "target_api": app.get("targetAPIVersion"),
        "module_name": m.get("name"),
        "module_type": m.get("type"),
        "main_element": m.get("mainElement"),
        "device_types": m.get("deviceTypes"),
        "permissions": [p.get("name") for p in m.get("requestPermissions", [])],
        "abilities": [a.get("name") for a in m.get("abilities", [])],
        "extension_abilities": [a.get("name") for a in m.get("extensionAbilities", [])],
        "signed": detect_signature(path),
    }


def rewrite_hap(src, dst, bundle_name=None, drop_permissions=(), add_permissions=()):
    """Rewrite module.json inside the HAP: rename bundle, edit permissions."""
    if os.path.abspath(src) == os.path.abspath(dst):
        die("rewrite_hap needs distinct src and dst")
    with zipfile.ZipFile(src) as zin:
        data = json.loads(zin.read("module.json"))

        if bundle_name:
            data["app"]["bundleName"] = bundle_name

        mod = data.get("module", {})
        perms = mod.get("requestPermissions", [])
        drop = set(drop_permissions)
        if drop:
            perms = [p for p in perms if p.get("name") not in drop]
        if add_permissions:
            have = {p.get("name") for p in perms}
            for name in add_permissions:
                if name not in have:
                    perms.append({"name": name})
        mod["requestPermissions"] = perms
        data["module"] = mod

        payload = json.dumps(data, ensure_ascii=False).encode()

        with zipfile.ZipFile(dst, "w") as zout:
            for item in zin.infolist():
                if item.filename == "module.json":
                    zout.writestr(item, payload)
                    continue
                if item.filename == "pack.info":
                    # keep metadata consistent with the renamed bundle
                    try:
                        pk = json.loads(zin.read(item))
                        if bundle_name:
                            pk["summary"]["app"]["bundleName"] = bundle_name
                        zout.writestr(item, json.dumps(pk, ensure_ascii=False).encode())
                    except Exception:
                        zout.writestr(item, zin.read(item))
                    continue
                zout.writestr(item, zin.read(item))
    return dst


def strip_unsupported(hap_path, profile_perms, out_path):
    """Remove permissions the profile does not allow (fixes 9568289)."""
    info = hap_info(hap_path)
    allowed = set(profile_perms)
    unwanted = [p for p in info["permissions"] if p not in allowed]
    if not unwanted:
        return out_path, []
    rewrite_hap(hap_path, out_path, drop_permissions=unwanted)
    return out_path, unwanted


# --------------------------------------------------------------------------
# certificates / profiles
# --------------------------------------------------------------------------
def _pem_blocks(text):
    return re.findall(r"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----", text, re.S)


def _openssl(args, data=None):
    r = subprocess.run(["openssl"] + args, input=data, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"openssl {' '.join(args)} failed: {r.stderr.strip()}")
    return r.stdout


def _cert_field(pem, what):
    out = _openssl(["x509", "-noout", "-nameopt", "RFC2253", "-" + what], pem).strip()
    return out.split("=", 1)[1] if "=" in out else out


def order_chain(cer_path, out_path):
    """AGC ships the chain root-first; hap-sign-tool wants leaf-first."""
    if not shutil.which("openssl"):
        die("openssl not found - required to reorder the certificate chain", code=3)
    with open(cer_path, encoding="utf-8", errors="ignore") as f:
        text = f.read()
    pems = [p.strip() + "\n" for p in _pem_blocks(text)]
    if not pems:
        # binary DER / PKCS#7 container
        try:
            conv = _openssl(["pkcs7", "-inform", "DER", "-print_certs", "-in", cer_path])
            pems = [p.strip() + "\n" for p in _pem_blocks(conv)]
        except RuntimeError:
            pems = [_openssl(["x509", "-inform", "DER", "-in", cer_path])]

    if len(pems) > 1:
        subjects = {_cert_field(c, "subject"): i for i, c in enumerate(pems)}
        issuers = {_cert_field(c, "issuer"): i for i, c in enumerate(pems)}
        leaves = [i for i in range(len(pems)) if _cert_field(pems[i], "subject") not in issuers]
        if len(leaves) == 1:
            chain, seen, cur = [pems[leaves[0]]], {leaves[0]}, leaves[0]
            while True:
                nxt = subjects.get(_cert_field(pems[cur], "issuer"))
                if nxt is None or nxt in seen:
                    break
                chain.append(pems[nxt])
                seen.add(nxt)
                cur = nxt
            chain += [c for i, c in enumerate(pems) if i not in seen]
            pems = chain

    with open(out_path, "w") as f:
        f.writelines(pems)
    return out_path, len(pems)


def profile_info(p7b_path, jar):
    with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as tf:
        out = tf.name
    try:
        r = run([java_cmd(), "-jar", jar, "verify-profile", "-inFile", p7b_path,
                 "-outFile", out], check=False)
        if not os.path.isfile(out) or os.path.getsize(out) == 0:
            raise RuntimeError(f"cannot parse profile: {(r.stdout or '') + (r.stderr or '')}")
        with open(out) as f:
            doc = json.load(f)["content"]
    finally:
        if os.path.exists(out):
            os.unlink(out)
    bi = doc.get("bundle-info", {})
    val = doc.get("validity", {})
    return {
        "path": os.path.abspath(p7b_path),
        "type": doc.get("type"),
        "bundle_name": bi.get("bundle-name"),
        "apl": bi.get("apl"),
        "app_feature": bi.get("app-feature"),
        "developer_id": bi.get("developer-id"),
        "not_before": val.get("not-before"),
        "not_after": val.get("not-after"),
        "expires": datetime.fromtimestamp(val["not-after"]).strftime("%Y-%m-%d")
        if val.get("not-after") else None,
        "days_left": (val["not-after"] - time.time()) // 86400 if val.get("not-after") else None,
        "device_ids": (doc.get("debug-info") or {}).get("device-ids", []),
        "allowed_acls": (doc.get("acls") or {}).get("allowed-acls", []),
        "restricted": (doc.get("permissions") or {}).get("restricted-permissions", []),
    }


def sign_material(args, jar):
    """Resolve p12 / cer / p7b / alias / password from flags, env or signing/."""
    signing = args.signing_dir or _guess_signing_dir()
    p12 = args.p12 or os.environ.get("HAPD_P12") or _first(signing, "*.p12")
    cer = args.cert or os.environ.get("HAPD_CERT") or _first(signing, "*.cer")
    p7b = args.profile or os.environ.get("HAPD_PROFILE") or _first(signing, "*.p7b")
    pwd = args.password or os.environ.get("HAPD_P12_PWD")
    alias = args.alias or os.environ.get("HAPD_ALIAS")

    if not all([p12, cer, p7b]):
        die("signing material not found. Pass --p12/--cert/--profile or set "
            "HAPD_P12/HAPD_CERT/HAPD_PROFILE (or put them in ./signing/)", code=3)
    if not pwd:
        die("keystore password missing. Pass --password or set HAPD_P12_PWD", code=3)
    if not alias:
        alias = _first_alias(p12, pwd) or die("cannot guess key alias; pass --alias", code=3)
    return p12, cer, p7b, alias, pwd


def _guess_signing_dir():
    for d in ("signing", "ednovas/signing", os.path.expanduser("~/.config/hapd/signing")):
        if os.path.isdir(d):
            return d
    return "signing"


def _first(d, pattern):
    hits = sorted(glob.glob(os.path.join(d, pattern)), key=os.path.getmtime, reverse=True)
    return hits[0] if hits else None


def _first_alias(p12, pwd):
    try:
        r = subprocess.run(["keytool", "-list", "-keystore", p12, "-storetype", "pkcs12",
                            "-storepass", pwd], capture_output=True, text=True)
        if r.returncode != 0:
            return None
        for line in r.stdout.splitlines():
            if "PrivateKeyEntry" in line:
                return line.split(",")[0].strip()
    except FileNotFoundError:
        pass
    return None


def do_sign(hap, out, args, jar):
    p12, cer, p7b, alias, pwd = sign_material(args, jar)
    prov = profile_info(p7b, jar)
    info = hap_info(hap)

    work = tempfile.mkdtemp(prefix="hapd-")
    try:
        src = hap

        # 1. bundle name
        if args.rename_bundle and args.rename_bundle != prov["bundle_name"]:
            die(f"--rename-bundle must equal the profile's bundle name "
                f"({prov['bundle_name']}), otherwise the device rejects the install.", code=2)
        if info["bundle_name"] != prov["bundle_name"]:
            if not args.rename_bundle:
                die(f"bundle name mismatch:\n  hap     : {info['bundle_name']}\n"
                    f"  profile : {prov['bundle_name']}\n"
                    f"Re-run with --rename-bundle {prov['bundle_name']} to rewrite the HAP, "
                    f"or create a profile for {info['bundle_name']}.", code=2)
            tmp = os.path.join(work, "renamed.hap")
            rewrite_hap(src, tmp, bundle_name=args.rename_bundle)
            eprint(f"  bundle renamed: {info['bundle_name']} -> {args.rename_bundle}")
            src = tmp

        # 2. permissions
        drop = list(args.drop_permission or [])
        if args.strip_unsupported:
            allowed = set(prov["allowed_acls"]) | set(prov["restricted"])
            cur = hap_info(src)["permissions"]
            drop += [p for p in cur if p not in allowed and p not in drop]
        if drop:
            tmp = os.path.join(work, "perms.hap")
            rewrite_hap(src, tmp, drop_permissions=drop)
            eprint(f"  permissions dropped: {', '.join(drop)}")
            src = tmp

        # 3. cert chain order
        chain = os.path.join(work, "chain.pem")
        order_chain(cer, chain)

        # 4. sign
        cmd = [java_cmd(), "-jar", jar, "sign-app",
               "-keyAlias", alias, "-signAlg", "SHA256withECDSA", "-mode", "localSign",
               "-appCertFile", chain, "-profileFile", p7b, "-inFile", src, "-outFile", out,
               "-keystoreFile", p12, "-keyPwd", pwd, "-keystorePwd", pwd,
               "-signCode", "0" if args.no_code_sign else "1"]
        if args.dry_run:
            return {"out": os.path.abspath(out), "bundle": prov["bundle_name"],
                    "profile": prov["path"], "dropped": drop, "dry_run": True}

        r = run(cmd, check=False)
        text = (r.stdout or "") + (r.stderr or "")
        if "sign-app success" not in text:
            die("sign-app failed:\n" + text.strip(), code=4)

        # 5. verify
        vcer = os.path.join(work, "v.cer")
        vp7b = os.path.join(work, "v.p7b")
        r = run([java_cmd(), "-jar", jar, "verify-app", "-inFile", out,
                 "-outCertChain", vcer, "-outProfile", vp7b], check=False)
        vtext = (r.stdout or "") + (r.stderr or "")
        if "verify-app success" not in vtext:
            die("verify-app failed:\n" + vtext.strip(), code=4)

        return {"out": os.path.abspath(out), "bundle": prov["bundle_name"],
                "profile": prov["path"], "dropped": drop}
    finally:
        shutil.rmtree(work, ignore_errors=True)


# --------------------------------------------------------------------------
# device commands
# --------------------------------------------------------------------------
def hdc(args_list, hdc_path, dry_run=False, check=True):
    return run([hdc_path] + args_list, dry_run=dry_run, check=check)


def devices(hdc_path):
    r = hdc(["list", "targets", "-v"], hdc_path, check=False)
    out = []
    for line in (r.stdout or "").splitlines():
        line = line.strip()
        if not line or line.startswith("[") or "Ver:" in line or "Empty" in line:
            continue
        parts = re.split(r"\s+", line)
        out.append({"target": parts[0],
                    "state": parts[2] if len(parts) > 2 else "?",
                    "transport": parts[1] if len(parts) > 1 else "?"})
    return out


def pick_target(hdc_path, explicit=None):
    if explicit:
        return explicit
    ds = [d for d in devices(hdc_path) if d["state"].lower() == "connected"]
    if not ds:
        return None
    return ds[0]["target"]


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------
def cmd_doctor(args, hdc_path, jar):
    rep = {"hapd": VERSION, "checks": [], "ok": True}

    def add(name, ok, detail):
        rep["checks"].append({"name": name, "ok": ok, "detail": detail})
        if not ok:
            rep["ok"] = False

    add("toolchain", True, os.path.dirname(os.path.dirname(os.path.dirname(
        os.path.dirname(os.path.dirname(hdc_path))))))
    add("hdc", True, hdc_path)
    add("hap-sign-tool", True, jar)
    jv = shutil.which("java")
    add("java", bool(jv), jv or "not found (JDK 17/21 required)")
    add("openssl", bool(shutil.which("openssl")), shutil.which("openssl") or "not found")
    add("keytool", bool(shutil.which("keytool")), shutil.which("keytool") or "not found")

    info = hdc(["-v"], hdc_path, check=False)
    add("hdc version", True, ((info.stdout or "") + (info.stderr or "")).strip())

    ds = devices(hdc_path)
    add("device", bool(ds), ", ".join(f"{d['target']}({d['state']})" for d in ds) or "none connected")

    try:
        p12, cer, p7b, alias, pwd = sign_material(args, jar)
    except HapdError as e:
        add("signing material", False, e.msg)
    else:
        add("signing material", True, f"p12={os.path.basename(p12)} alias={alias} "
                                      f"profile={os.path.basename(p7b)}")
        try:
            prov = profile_info(p7b, jar)
        except (HapdError, RuntimeError) as e:
            add("profile readable", False, str(e).splitlines()[0][:160])
        else:
            add("profile valid", (prov["days_left"] or 0) > 0,
                f"bundle={prov['bundle_name']} expires={prov['expires']} "
                f"({prov['days_left']} days left)")
            if ds and prov["device_ids"]:
                udid = device_udid(hdc_path, ds[0]["target"])
                add("device in profile", udid in prov["device_ids"],
                    f"udid={udid[:16]}..." if udid else "cannot read UDID")

    if args.json:
        print(json.dumps(rep, indent=2))
    else:
        print(f"hapd {VERSION}")
        for c in rep["checks"]:
            print(f"  [{'ok' if c['ok'] else '!!'}] {c['name']:<18} {c['detail']}")
    return 0 if rep["ok"] else 1


def device_udid(hdc_path, target):
    r = hdc(["-t", target, "shell", "bm", "get", "--udid"], hdc_path, check=False)
    m = re.search(r"([0-9A-Fa-f]{32,64})", (r.stdout or "") + (r.stderr or ""))
    return m.group(1) if m else None


def installed_version(hdc_path, target, bundle):
    """Return the installed versionCode for a bundle, or None."""
    if not bundle:
        return None
    r = hdc(["-t", target, "shell", "bm", "dump", "-n", bundle], hdc_path, check=False) \
        if target else \
        hdc(["shell", "bm", "dump", "-n", bundle], hdc_path, check=False)
    return parse_version_code((r.stdout or "") + (r.stderr or ""))


def parse_version_code(bm_dump_text):
    """Pull the bundle's own versionCode out of `bm dump` output.

    Careful: the dump is large and full of decoys - shared-bundle dependencies,
    nested `applicationInfo` records in module info (versionCode 0), and
    `minCompatibleVersionCode` (often date-based, e.g. 2026110201). Take the
    top-level `applicationInfo.versionCode` from the parsed JSON; only fall back
    to a regex when the payload is not valid JSON.
    """
    text = bm_dump_text.strip()
    # `bm dump -n <bundle>` prefixes the payload with "<bundle>:" on its own line
    brace = text.find("{")
    if brace > 0:
        text = text[brace:]
    try:
        doc = json.loads(text)
    except (ValueError, TypeError):
        doc = None
    if isinstance(doc, dict):
        app = doc.get("applicationInfo")
        if isinstance(app, dict) and isinstance(app.get("versionCode"), int):
            if app["versionCode"]:
                return app["versionCode"]
        if isinstance(doc.get("versionCode"), int) and doc["versionCode"]:
            return doc["versionCode"]
        return None
    m = re.search(r'^    "versionCode"\s*:\s*(\d+)', bm_dump_text, re.M)
    return int(m.group(1)) if m else None


def cmd_devices(args, hdc_path, jar):
    ds = devices(hdc_path)
    if args.json:
        print(json.dumps(ds, indent=2))
    elif not ds:
        print("no devices connected (hapd connect <ip:port>)")
    else:
        for d in ds:
            print(f"{d['target']:<24} {d['state']:<14} {d['transport']}")
    return 0


def cmd_udid(args, hdc_path, jar):
    tgt = pick_target(hdc_path, args.target)
    udid = device_udid(hdc_path, tgt) if tgt else None
    if args.json:
        print(json.dumps({"target": tgt, "udid": udid}, indent=2))
    else:
        print(udid or "not connected")
    return 0 if udid else 1


def cmd_connect(args, hdc_path, jar):
    r = hdc(["tconn", args.addr], hdc_path, dry_run=args.dry_run, check=False)
    txt = ((r.stdout or "") + (r.stderr or "")).strip()
    low = txt.lower()
    ok = args.dry_run or "connect ok" in low or "repeat operation" in low
    if args.json:
        print(json.dumps({"ok": ok, "addr": args.addr, "output": txt}, indent=2))
    else:
        print(txt or ("connected to " + args.addr if ok else "failed"))
    if ok:
        ds = [d for d in devices(hdc_path) if d["state"].lower() == "connected"]
        if not args.json and not ds:
            eprint("note: connect accepted, but the device is not 'Connected' yet - "
                   "unlock the phone and accept the debug authorization dialog")
    return 0 if ok else 5


