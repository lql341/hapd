def pubkey_fp(pem):
    """SHA-256 of the SubjectPublicKeyInfo DER - stable across certificate reissues
    as long as the key pair is the same."""
    import hashlib
    r = subprocess.run(["openssl", "x509", "-pubkey", "-noout"],
                       input=pem.encode(), capture_output=True)
    if r.returncode != 0:
        return None
    r2 = subprocess.run(["openssl", "pkey", "-pubin", "-outform", "DER"],
                        input=r.stdout, capture_output=True)
    return hashlib.sha256(r2.stdout).hexdigest() if r2.returncode == 0 else None


def _cert_pubkey_fp(cert_path):
    if not os.path.isfile(cert_path):
        return None
    with open(cert_path, encoding="utf-8", errors="ignore") as f:
        text = f.read()
    pems = _pem_blocks(text)
    if not pems:
        return None
    leaf = pems[0] if len(pems) > 1 else pems[0]
    # AGC ships root-first; the leaf is the one that is not a CA issuer
    try:
        subjects = {_cert_field(c, "subject") for c in pems}
        leaves = [c for c in pems if _cert_field(c, "issuer") not in subjects] or pems
        leaf = leaves[0]
    except Exception:  # noqa: BLE001
        pass
    return pubkey_fp(leaf)


def cmd_renew(args, hdc_path, jar):
    """Compare replacement signing material with what is currently in use."""
    old_cert = args.old_cert or os.environ.get("HAPD_CERT")
    new_cert = args.cert or os.environ.get("HAPD_CERT")
    new_p7b = args.profile or os.environ.get("HAPD_PROFILE")
    if not new_p7b or not os.path.isfile(new_p7b):
        die("need the NEW profile: --profile new.p7b (or set HAPD_PROFILE)", code=2)

    prov = profile_info(new_p7b, jar)
    rep = {"profile": prov, "checks": [], "ok": True}

    def add(name, ok, detail):
        rep["checks"].append({"name": name, "ok": ok, "detail": detail})
        if not ok:
            rep["ok"] = False

    add("profile valid", (prov["days_left"] or 0) > 0,
        f"expires {prov['expires']} ({prov['days_left']} days left)")
    add("profile type", prov["type"] == "debug", f"type={prov['type']}")

    if args.bundle:
        add("bundle match", args.bundle == prov["bundle_name"],
            f"expected {args.bundle}, profile has {prov['bundle_name']}")

    tgt = pick_target(hdc_path, args.target)
    udid = device_udid(hdc_path, tgt) if tgt else None
    if udid:
        add("device in profile", udid in prov["device_ids"],
            f"{udid[:16]}... in {len(prov['device_ids'])} device id(s)")

    if old_cert and new_cert and os.path.isfile(old_cert) and os.path.isfile(new_cert)             and os.path.abspath(old_cert) != os.path.abspath(new_cert):
        old_fp = _cert_pubkey_fp(old_cert)
        new_fp = _cert_pubkey_fp(new_cert)
        same = bool(old_fp) and old_fp == new_fp
        add("same signing identity", same,
            "public keys match -> the new build can be installed over the old one, "
            "app data is kept" if same else
            "public keys DIFFER -> an uninstall is required first, app data is lost")
        rep["overwrite_install_safe"] = same

    if args.json:
        print(json.dumps(rep, indent=2))
    else:
        for c in rep["checks"]:
            print(f"  [{'ok' if c['ok'] else '!!'}] {c['name']:<22} {c['detail']}")
        if "overwrite_install_safe" in rep:
            print()
            print("overwrite install keeps app data"
                  if rep["overwrite_install_safe"] else
                  "uninstall required first: app data will be lost")
    return 0 if rep["ok"] else 1


def cmd_keygen(args, hdc_path, jar):
    """Generate a keystore + certificate signing request the AGC way."""
    os.makedirs(args.out, exist_ok=True)
    p12 = os.path.join(args.out, args.name + ".p12")
    csr = os.path.join(args.out, args.name + ".csr")
    alias = args.alias or args.name
    pwd = args.password or os.environ.get("HAPD_P12_PWD")
    if not pwd:
        die("missing password: pass --password or set HAPD_P12_PWD", code=2)
    if os.path.exists(p12) and not args.force:
        die(f"{p12} already exists (use --force to overwrite)", code=2)
    dname = args.dname or f"C=CN,O={alias},OU=HarmonyOS,CN={alias}"

    run(["keytool", "-genkeypair", "-alias", alias, "-keyalg", "EC",
         "-groupname", "secp256r1", "-sigalg", "SHA256withECDSA", "-dname", dname,
         "-keystore", p12, "-storetype", "pkcs12", "-validity", str(args.days),
         "-storepass", pwd, "-keypass", pwd], dry_run=args.dry_run)
    run(["keytool", "-certreq", "-alias", alias, "-sigalg", "SHA256withECDSA",
         "-keystore", p12, "-storetype", "pkcs12", "-file", csr,
         "-storepass", pwd], dry_run=args.dry_run)

    res = {"p12": os.path.abspath(p12), "csr": os.path.abspath(csr), "alias": alias}
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print(f"keystore : {res['p12']}")
        print(f"csr      : {res['csr']}")
        print(f"alias    : {alias}")
        print()
        print("Next: upload the CSR to AppGallery Connect to get a debug certificate,")
        print("then create a debug profile for your bundle name and device UDID.")
    return 0


def _hint_for(text):
    for code, (_, _, fix) in ERRORS.items():
        if code in text:
            return f"{code}: {fix}"
    return None


def _preflight(args, hdc_path, jar, bundle):
    """Warn (do not fail) when the device cannot possibly accept this bundle."""
    tgt = pick_target(hdc_path, args.target)
    if not tgt:
        return
    udid = device_udid(hdc_path, tgt)
    if not udid:
        return
    try:
        p12, cer, p7b, alias, pwd = sign_material(args, jar)
        prov = profile_info(p7b, jar)
    except (HapdError, RuntimeError):
        return
    if prov["device_ids"] and udid not in prov["device_ids"]:
        eprint(f"warning: device {udid[:16]}... is not in the profile's device list; "
               f"the install will fail (9568266)")
    if (prov["days_left"] or 1) <= 0:
        eprint(f"warning: profile expired on {prov['expires']}")


def cmd_deploy(args, hdc_path, jar):
    files = list(args.hap)

    if args.dry_run:
        shared, normal = order_for_install(files)
        for f in files:
            print(f"[dry-run] sign {f} -> {_default_out(f)}")
        for pkg in shared:
            print(f"[dry-run] {hdc_path} install -r -s {pkg}")
        for pkg in normal:
            print(f"[dry-run] {hdc_path} install -r {pkg}")
        if not args.no_run:
            try:
                bundle = hap_info(files[0])["bundle_name"]
            except HapdError:
                bundle = "<bundle>"
            print(f"[dry-run] {hdc_path} shell aa start -a EntryAbility -b {bundle} -m entry")
        return 0

    signed = []
    for f in files:
        out = args.output if (args.output and len(files) == 1) else _default_out(f)
        signed.append(do_sign(f, out, args, jar))

    entry = next((r for r in signed if _module_type(r["out"]) != "shared"), signed[0])
    bundle = entry["bundle"]
    if args.no_install:
        for r in signed:
            print(r["out"])
        return 0

    _preflight(args, hdc_path, jar, bundle)
    tgt = pick_target(hdc_path, args.target)

    shared, normal = order_for_install([r["out"] for r in signed])
    ok_all, txt = True, ""
    for pkg, is_shared in [(p, True) for p in shared] + [(p, False) for p in normal]:
        ok, out = _install_once(hdc_path, tgt, pkg, args.dry_run, shared=is_shared)
        if not ok:
            ok_all, txt = False, out
            break
    if not ok_all and args.auto_fix:
        for attempt in range(1, args.max_fix + 1):
            if "9568332" in txt or "9568263" in txt:
                eprint(f"  [auto-fix {attempt}] existing install blocks this one: "
                       f"uninstalling {bundle}")
                _uninstall(hdc_path, tgt, bundle, args.dry_run)
            elif "9568289" in txt and not args.strip_unsupported:
                eprint(f"  [auto-fix {attempt}] 9568289: stripping unsupported permissions")
                args.strip_unsupported = True
                signed = []
                for f in files:
                    out = args.output if (args.output and len(files) == 1) else _default_out(f)
                    signed.append(do_sign(f, out, args, jar))
                shared, normal = order_for_install([r["out"] for r in signed])
            else:
                break
            ok_all, txt = True, ""
            for pkg, is_shared in [(p, True) for p in shared] + [(p, False) for p in normal]:
                ok, out = _install_once(hdc_path, tgt, pkg, args.dry_run, shared=is_shared)
                if not ok:
                    ok_all, txt = False, out
                    break
            if ok_all:
                break

    if not ok_all:
        if args.json:
            print(json.dumps({"ok": False, "bundle": bundle, "output": txt}, indent=2))
        else:
            print(txt)
        hint = _hint_for(txt)
        if hint:
            eprint("hint: " + hint)
        return 5
    if not args.json:
        for r in signed:
            print(f"installed: {os.path.basename(r['out'])}")

    if args.no_run:
        return 0
    return cmd_run(argparse.Namespace(bundle=bundle, ability=None, module="entry",
                                      target=args.target, hap=entry["out"],
                                      json=args.json, dry_run=args.dry_run), hdc_path, jar)


def _module_type(path):
    try:
        return hap_info(path).get("module_type")
    except HapdError:
        return None


def cmd_update(args, hdc_path, jar):
    src = args.source
    if src.startswith(("http://", "https://")):
        name = os.path.basename(src.split("?")[0])
        dest = os.path.join(args.dir, name)
        if not os.path.exists(dest):
            if args.dry_run:
                eprint(f"[dry-run] download {src} -> {dest}")
                return 0
            os.makedirs(args.dir, exist_ok=True)
            run(["curl", "-fL", "--progress-bar", "-o", dest + ".part", src], capture=False)
            os.replace(dest + ".part", dest)
        src = dest
    return cmd_deploy(argparse.Namespace(hap=[src], output=args.output, p12=args.p12,
                                         cert=args.cert, profile=args.profile,
                                         password=args.password, alias=args.alias,
                                         rename_bundle=args.rename_bundle,
                                         drop_permission=args.drop_permission,
                                         strip_unsupported=args.strip_unsupported,
                                         no_code_sign=False, signing_dir=args.signing_dir,
                                         no_install=args.no_install, no_run=args.no_run,
                                         replace=args.replace, auto_fix=args.auto_fix,
                                         max_fix=args.max_fix, target=args.target, json=args.json,
                                         dry_run=args.dry_run), hdc_path, jar)


def cmd_explain(args, hdc_path, jar):
    code = str(args.code).lower().replace("0x", "")
    hit = ERRORS.get(code)
    if not hit and code.startswith("error"):
        hit = ERRORS.get(re.sub(r"\D", "", code))
    if not hit:
        die(f"unknown error code: {args.code}", code=2)
    title, why, fix = hit
    if args.json:
        print(json.dumps({"code": code, "title": title, "why": why, "fix": fix}, indent=2))
    else:
        print(f"{code}: {title}\n  why: {why}\n  fix: {fix}")
    return 0


