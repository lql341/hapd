    "9568289": ("Install rejected: permission not granted",
                "The HAP requests a permission that the profile does not allow.",
                "Strip the permission (`hapd sign --drop-permission X`) or grant it in AGC."),
    "9568322": ("Bundle name does not match the profile",
                "The profile's bundle-name differs from the HAP's bundleName.",
                "Rename the bundle (`hapd sign --rename-bundle <profile-bundle>`) or "
                "create a profile for this bundle name."),
    "9568332": ("Signature differs from the installed app",
                "An app with the same bundle name is installed but signed with another key.",
                "Uninstall first: `hapd uninstall <bundle>` then install."),
    "10106102": ("Ability launch refused: device screen locked",
