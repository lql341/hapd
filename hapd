def cmd_sign(args, hdc_path, jar):
    files = list(args.hap)
    out_all = []
    for f in files:
        out = args.output if (args.output and len(files) == 1) else _default_out(f)
        res = do_sign(f, out, args, jar)
        out_all.append(res)
        if not args.json:
            print(f"signed: {res['out']}")
            print(f"bundle: {res['bundle']}")
    if args.json:
        print(json.dumps(out_all if len(out_all) > 1 else out_all[0], indent=2))
    return 0


def _default_out(hap):
    if hap.endswith("-unsigned.hap"):
        return hap[: -len("-unsigned.hap")] + "-signed.hap"
    return hap[: -len(".hap")] + "-signed.hap"


def _install_once(hdc_path, target, hap, dry_run=False, shared=False):
    flags = ["-r"] + (["-s"] if shared else [])
    cmd = [hdc_path] + (["-t", target] if target else []) + ["install"] + flags + [hap]
    r = run(cmd, dry_run=dry_run, check=False)
    txt = ((r.stdout or "") + (r.stderr or "")).strip()
    return "successfully" in txt, txt


def order_for_install(paths):
    """Split packages into (shared bundles, normal modules).

    HSP must be installed before the HAP that depends on it, and with `-s`.
    Unknown packages are treated as normal so a broken one still reports its error.
    """
    shared, normal = [], []
    for p in paths:
        try:
            kind = hap_info(p).get("module_type")
        except HapdError:
            kind = None
        (shared if kind == "shared" else normal).append(p)
    return shared, normal


def cmd_install(args, hdc_path, jar):
    files = list(args.hap)
    if args.sign:
        signed = []
        for f in files:
            out = args.output if (args.output and len(files) == 1) else _default_out(f)
            signed.append(do_sign(f, out, args, jar)["out"])
        files = signed

    tgt = pick_target(hdc_path, args.target)
    bundle = None
    for f in files:
        try:
            bundle = bundle or hap_info(f)["bundle_name"]
        except HapdError:
            pass

    if getattr(args, "uninstall", False) and bundle:
        ok, _ = _uninstall(hdc_path, tgt, bundle, args.dry_run)
        eprint(f"  uninstall {bundle}: {'ok' if ok else 'not installed'}")

    if not args.dry_run and bundle and tgt and not getattr(args, "uninstall", False):
        try:
            pkg_code = hap_info(next(f for f in files if hap_info(f)["module_type"] != "shared"))["version_code"]
        except (HapdError, StopIteration):
            pkg_code = None
        have = installed_version(hdc_path, tgt, bundle)
        if pkg_code and have and have > pkg_code:
            eprint(f"warning: installed {bundle} has versionCode {have}, this package has "
                   f"{pkg_code} -> the device will refuse it as a downgrade (9568263); "
                   f"use --replace to uninstall first (app data is lost)")

    results = []
    ok_all = True
    shared, normal = order_for_install(files)
    for pkg, is_shared in [(p, True) for p in shared] + [(p, False) for p in normal]:
        label = "shared" if is_shared else "module"
        ok, txt = _install_once(hdc_path, tgt, pkg, args.dry_run, shared=is_shared)
        blocking = "9568332" in txt or "9568263" in txt
        if (not ok and getattr(args, "replace", False) and blocking
                and bundle and not is_shared):
            eprint(f"  {txt.split('code:')[-1][:7]}: existing install blocks this one, "
                   f"uninstalling {bundle}")
            _uninstall(hdc_path, tgt, bundle, args.dry_run)
            ok, txt = _install_once(hdc_path, tgt, pkg, args.dry_run, shared=is_shared)
        if not ok:
            ok_all = False
            hint = _hint_for(txt)
            if hint:
                eprint("hint: " + hint)
        results.append({"file": os.path.basename(pkg), "kind": label, "ok": ok, "output": txt})
        if not args.json:
            print(f"[{label}] {os.path.basename(pkg)}: {'ok' if ok else 'FAILED'}", flush=True)
            if not ok:
                print("  " + txt.replace("\n", "\n  "), flush=True)
        if not ok:
            break

    if args.json:
        print(json.dumps({"ok": ok_all, "bundle": bundle, "installs": results}, indent=2))
    return 0 if ok_all else 5


def _uninstall(hdc_path, target, bundle, dry_run=False):
    cmd = [hdc_path] + (["-t", target] if target else []) + ["uninstall", bundle]
    r = run(cmd, dry_run=dry_run, check=False)
    txt = ((r.stdout or "") + (r.stderr or "")).strip()
    return "success" in txt.lower(), txt


