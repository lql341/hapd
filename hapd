#!/usr/bin/env python3
"""hapd - sign, install and debug HarmonyOS HAP packages from Linux.

No DevEco Studio, no Windows, no macOS. Wraps the official HarmonyOS
Command Line Tools (hdc + hap-sign-tool) into one non-interactive CLI.

Every command supports --json for agent consumption.
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile
from datetime import datetime

VERSION = "0.1.0"

