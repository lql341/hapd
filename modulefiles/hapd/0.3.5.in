#%Module
# Environment Modules file for hapd. Generated by install.sh - do not edit.
#
#   module load hapd            # add hapd to PATH
#   module load hapd/0.1.0      # pin a version
proc ModulesHelp { } {
    puts stderr "hapd @VERSION@ - sign, install and debug HarmonyOS HAP packages"
    puts stderr ""
    puts stderr "  hapd doctor          check toolchain, signing material, device"
    puts stderr "  hapd deploy app.hap  sign + install + launch"
    puts stderr "  hapd --help          full command list"
    puts stderr ""
    puts stderr "  HAPD_HOME = @ROOT@"
}
module-whatis "hapd @VERSION@ - HarmonyOS HAP sign/install/debug CLI"

set root @ROOT@
prepend-path PATH $root
setenv HAPD_HOME $root

# Optional machine-local overrides (keystore, certificate, profile, password).
# Deliberately untracked by git: it is not part of the distribution.
set local [file join $root hapd.local.tcl]
if {[file readable $local]} {
    source $local
}
